{
  "version": "1.2.0",
  "authority": "Taghvim-dev/.github",
  "constitution": "T0 canonical, pre-effect, authenticated-current-source-only, fail-closed",
  "product": "Taghvim.dev",
  "notification_policy": "Deterministic bounded current-main/open-PR scan on schedule; NO per-completion workflow_run fanout, no skipped cascade, current SHA only, one durable actionable incident per workflow+branch, successful same-source recovery only.",
  "monitored_repositories": {
    "Taghvim-dev/engine": [
      "controlled-engine-release",
      "public-api-release-observation",
      "t0-central-landing-cloudflare-release",
      "t0-cloudflare-d1-readonly-probe",
      "t0-cloudflare-workers-live-readonly-observation",
      "t0-engine-sandbox-d1-bootstrap",
      "t0-engine-sandbox-d1-migration",
      "t0-immutable-landing-sandbox-d1-recovery",
      "t0-live-readiness",
      "t0-owner-protected-release-request",
      "t0-private-landing-source-readonly-probe",
      "t0-public-api-readonly-smoke-observation",
      "t0-sandbox-http-readonly-route-diagnostic",
      "test"
    ],
    "Taghvim-dev/landing": [
      "controlled-landing-release",
      "landing-verify",
      "t0-owner-protected-release-request",
      "t0-public-landing-readonly-smoke-observation",
      "t0-web-sandbox-d1-bootstrap",
      "visual-rtl-acceptance"
    ],
    "Taghvim-dev/SDK": [
      "public-sdk-verify"
    ],
    "Taghvim-dev/CLI": [
      "public-cli-verify"
    ],
    "Taghvim-dev/cookbooks": [
      "public-cookbooks-verify"
    ],
    "Taghvim-dev/.github": [
      "public-docs-verify",
      "coordinated-public-release",
      "t0-public-widget-sdk-reconciler",
      "d1-applied-ledger-contract",
      "d1-prefix-contract",
      "d1-recovery-bookmark-contract",
      "durable-private-release-registry-contract",
      "release-checkpoint-contract",
      "sandbox-origin-ownership-contract",
      "t0-current-source-admission-contract",
      "verify-production-environment-contract"
    ]
  },
  "outcomes": {
    "incident": [
      "failure",
      "timed_out",
      "startup_failure",
      "action_required"
    ],
    "recovery": [
      "success"
    ],
    "ignore": [
      "cancelled",
      "skipped",
      "neutral"
    ]
  },
  "allowed_events": [
    "push",
    "pull_request",
    "workflow_dispatch",
    "issue_comment",
    "schedule"
  ],
  "trusted_actions_only": true,
  "production_mutation_authority": false,
  "event_admission": {
    "version": 2,
    "mode": "schedule_poll_current_main_and_open_pr_heads",
    "poll_incident_outcomes": [
      "failure",
      "timed_out",
      "startup_failure",
      "action_required"
    ],
    "sweep_cron": "13 */3 * * *",
    "max_run_pages": 3,
    "no_fork_dispatch": true,
    "no_untrusted_checkout": true,
    "no_incident_for": [
      "skipped",
      "cancelled",
      "neutral",
      "superseded_source",
      "closed_pr",
      "foreign_repo"
    ],
    "zero_step_boundary": "PRE_RUNNER_PLATFORM_OR_QUOTA",
    "green_recovery_requires": "same_current_SHA_workflow_event_branch_newer_success",
    "capabilities": "T0 CI incident tracking only; no deployment, billing, GA or permission escalation"
  },
  "coverage_rule": "Canonical monitored repository/workflow inventory only. Six thin main-branch adapters call one SHA-pinned shared action; schedule/dispatch polling replaces workflow_run listener. Pre-effect snapshot, bounded fail-closed source identity, CAS issue writes.",
  "blocked_reconciliation_policy": "WAIT_FOR_PRIVATE_SOURCE_READ_AUTHORITY is BLOCKED_CROSS_REPO_AUTH, never GA or a successful cross-repo source reconciliation."
}
